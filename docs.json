                  "pt-br/api-reference/endpoints/account",
                  "pt-br/api-reference/endpoints/inbox",
                  "pt-br/api-reference/endpoints/backlog",
                  "pt-br/api-reference/endpoints/board",
                  "pt-br/api-reference/endpoints/cards",
                  "pt-br/api-reference/endpoints/forge",
