{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Tylon",
  "colors": {
    "primary": "#171717",
    "light": "#E5E5E5",
    "dark": "#171717"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "Core concepts",
                "icon": "book-open",
                "pages": [
                  "en/concepts/cards",
                  "en/concepts/flow",
                  "en/concepts/releases"
                ]
              },
              {
                "group": "The screens",
                "icon": "monitor",
                "pages": [
                  "en/screens/inbox",
                  "en/screens/backlog",
                  "en/screens/board",
                  "en/screens/card",
                  "en/screens/flow",
                  "en/screens/trunk",
                  "en/screens/releases",
                  "en/screens/projects",
                  "en/screens/docs",
                  "en/screens/agents",
                  "en/screens/runs",
                  "en/screens/settings"
                ]
              },
              {
                "group": "MCP server",
                "icon": "terminal",
                "pages": [
                  "en/mcp/connect",
                  "en/mcp/tools"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "en/api-reference/introduction",
                  "en/api-reference/authentication",
                  "en/api-reference/workspaces",
                  "en/api-reference/writing",
                  "en/api-reference/errors"
                ]
              },
              {
                "group": "Endpoints",
                "icon": "list",
                "pages": [
                  "en/api-reference/endpoints/account",
                  "en/api-reference/endpoints/inbox",
                  "en/api-reference/endpoints/backlog",
                  "en/api-reference/endpoints/board",
                  "en/api-reference/endpoints/cards",
                  "en/api-reference/endpoints/forge",
                  "en/api-reference/endpoints/releases",
                  "en/api-reference/endpoints/trunk",
                  "en/api-reference/endpoints/projects",
                  "en/api-reference/endpoints/labels",
                  "en/api-reference/endpoints/features",
                  "en/api-reference/endpoints/docs"
                ]
              }
            ]
          }
        ]
