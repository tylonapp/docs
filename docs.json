{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Tylon",
  "colors": {
    "primary": "#171717",
    "light": "#E5E5E5",
    "dark": "#171717"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core concepts",
            "icon": "book-open",
            "pages": [
              "concepts/cards",
              "concepts/flow",
              "concepts/releases"
            ]
          },
          {
            "group": "MCP server",
            "icon": "terminal",
            "pages": [
              "mcp/connect",
              "mcp/tools"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/workspaces",
              "api-reference/writing",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "icon": "list",
            "pages": [
              "api-reference/endpoints/account",
              "api-reference/endpoints/inbox",
              "api-reference/endpoints/backlog",
              "api-reference/endpoints/board",
              "api-reference/endpoints/cards",
              "api-reference/endpoints/forge",
              "api-reference/endpoints/releases",
              "api-reference/endpoints/trunk",
              "api-reference/endpoints/projects",
              "api-reference/endpoints/labels",
              "api-reference/endpoints/features",
              "api-reference/endpoints/docs"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Tylon",
      "href": "https://dash.tylon.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Tylon is Git's control panel: a board whose columns are real branches. Documentation for the public API and the MCP server.",
  "background": {
    "light": "#FFFFFF",
    "dark": "#0A0A0A"
  },
  "redirects": [
    {
      "source": "/api-reference/endpoints/me",
      "destination": "/api-reference/endpoints/account",
      "permanent": true
    }
  ]
}
